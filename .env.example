# Cognito Hosted UI — valores reales vienen de `terraform output` una vez
# desplegado (ver terraform/cognito.tf, terraform/outputs.tf). Sin secretos:
# el user pool client es público (generate_secret = false), PKCE no lo necesita.

# terraform output: cognito_hosted_ui_domain
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# terraform output: cognito_app_client_id
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# terraform var frontend_residente_origin + /auth/callback — debe coincidir
# EXACTO con callback_urls en cognito.tf (hoy registra el origen pelado sin
# el sufijo /auth/callback, hay que agregarlo ahí antes de desplegar).
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
